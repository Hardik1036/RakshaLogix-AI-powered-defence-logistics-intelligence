# RakshaLogix Frontend Environment Configuration
# Replace with your deployed FastAPI backend URL
VITE_API_URL=https://rakshalogix-backend.onrender.com

# Set to true to use standalone frontend client-side mock data without backend dependency
VITE_USE_MOCK=false

# Development bypass for authentication (false for production / standard RBAC evaluation)
VITE_DEV_DISABLE_AUTH=false
